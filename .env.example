# Copy to .env and fill in. Everything here is optional — with none of
# these set, the bot runs fully offline in mock mode (free, no API keys).

# --- Real OpenAI mode (omit to stay in mock mode) ---
# OPENAI_API_KEY=sk-...
# pip install openai   # only needed for real mode

# --- Model + retrieval tuning ---
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# CHUNK_SIZE=120
# CHUNK_OVERLAP=20
# TOP_K=2
# SIMILARITY_THRESHOLD=0.08

# --- Knowledge base ---
# DOCS_PATH=data/docs.json
